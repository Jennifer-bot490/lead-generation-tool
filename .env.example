# Copy to ".env". No API keys are needed.
# Your contact email is added to the scraper's User-Agent so site owners can reach you
# (OpenStreetMap's usage policy asks for this). Use a real address.
CONTACT_EMAIL=you@example.com
# Max searches per visitor per minute
RATE_LIMIT_PER_MIN=5
# Seconds to wait between requests to the same website
REQUEST_DELAY=1.5
# Country code used to format local phone numbers that start with 0 (92 = Pakistan)
DEFAULT_COUNTRY_CODE=92
